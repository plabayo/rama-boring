+int RAMA_SSL_set_cert_compression_algs(SSL *ssl, const uint16_t *ids,
+                                       size_t num) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (rama_wire_config(ssl) == nullptr) {
+    return 0;
+  }
+  if (ids == nullptr && num != 0) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_PASSED_NULL_PARAMETER);
+    return 0;
+  }
+  // Only algorithms registered on the context can be offered or used.
+  for (size_t i = 0; i < num; i++) {
+    bool registered = false;
+    for (const auto &alg : ssl_impl->ctx->cert_compression_algs) {
+      registered |= alg.alg_id == ids[i];
+    }
+    for (size_t j = 0; j < i; j++) {
+      registered &= ids[j] != ids[i];
+    }
+    if (!registered) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_UNKNOWN_CERT_COMPRESSION_ALG);
+      return 0;
+    }
+  }
+  RamaConnectionConfig *rama = rama_connection_config(ssl_impl->config.get());
+  if (rama == nullptr || !rama->cert_compression_algs.CopyFrom(Span(ids, num))) {
+    return 0;
+  }
+  rama->cert_compression_set = true;
+  return 1;
+}
+
+int RAMA_SSL_set_tls13_server_ciphers(SSL *ssl, const uint16_t *ids,
+                                      size_t num, int strict) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (rama_wire_config(ssl) == nullptr) {
+    return 0;
+  }
+  if (strict && num == 0) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHER_MATCH);
+    return 0;
+  }
+  if (ids == nullptr && num != 0) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_PASSED_NULL_PARAMETER);
+    return 0;
+  }
+  for (size_t i = 0; i < num; i++) {
+    const SSL_CIPHER *cipher = SSL_get_cipher_by_value(ids[i]);
+    if (cipher == nullptr ||
+        SSL_CIPHER_get_min_version(cipher) > TLS1_3_VERSION ||
+        SSL_CIPHER_get_max_version(cipher) < TLS1_3_VERSION) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_UNKNOWN_CIPHER_RETURNED);
+      return 0;
+    }
+  }
+  RamaConnectionConfig *rama = rama_connection_config(ssl_impl->config.get());
+  if (rama == nullptr || !rama->tls13_server_ciphers.CopyFrom(Span(ids, num))) {
+    return 0;
+  }
+  rama->tls13_server_ciphers_strict = !!strict;
+  return 1;
