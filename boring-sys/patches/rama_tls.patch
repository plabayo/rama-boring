+      config == nullptr ? nullptr : rama_connection_config(config);
+  if (rama == nullptr) {
+    return 0;
+  }
+  static_assert(kMaxTickets <= 0xff, "Too many tickets.");
+  rama->num_tickets = static_cast<uint8_t>(std::min(num_tickets, kMaxTickets));
+  rama->num_tickets_set = true;
+  return 1;
+}
