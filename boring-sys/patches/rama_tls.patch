+// rama_client_hello_config returns the per-connection settings of a client
+// that has not yet written its ClientHello, or nullptr with an error.
+static RamaConnectionConfig *rama_client_hello_config(SSL *ssl) {
+  auto *ssl_impl = FromOpaque(ssl);
+  const SSL_HANDSHAKE *hs = ssl_impl->s3->hs.get();
+  // Only a client that has not yet written its ClientHello can be shaped, so
+  // a HelloRetryRequest never sees a different shape.
+  if (!ssl_impl->config || ssl_impl->server || hs == nullptr ||
+      ssl_impl->s3->initial_handshake_complete || hs->state != 0) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return nullptr;
+  }
+  RamaConnectionConfig *rama = rama_connection_config(ssl_impl->config.get());
+  if (rama == nullptr) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_MALLOC_FAILURE);
+  }
+  return rama;
+}
