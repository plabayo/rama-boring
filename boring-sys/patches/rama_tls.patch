+int RAMA_SSL_set_client_hello_shape(SSL *ssl,
+                                    const RAMA_SSL_CLIENT_HELLO_SHAPE *shape) {
+  RamaConnectionConfig *rama = rama_client_hello_config(ssl);
+  if (rama == nullptr) {
+    return 0;
+  }
+  if (shape == nullptr || (shape->extension_bodies == nullptr &&
+                           shape->num_extension_bodies != 0)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_PASSED_NULL_PARAMETER);
+    return 0;
+  }
+  // Validate everything before changing anything: a rejected shape leaves the
+  // previous one in place.
+  if ((shape->grease_lists_set && (shape->grease_lists & ~uint32_t{0x3f})) ||
+      shape->grease_values < RAMA_SSL_GREASE_VALUES_FRESH ||
+      shape->grease_values > RAMA_SSL_GREASE_VALUES_PINNED ||
+      shape->unknown_values < RAMA_SSL_UNKNOWN_DROP ||
+      shape->unknown_values > RAMA_SSL_UNKNOWN_PRESERVE ||
+      shape->padding < RAMA_SSL_PADDING_NATIVE ||
+      shape->padding > RAMA_SSL_PADDING_TO_LENGTH ||
+      shape->padding_length > 0xffff ||
+      shape->num_extension_bodies > RAMA_SSL_MAX_EXTENSION_ORDER) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_OVERFLOW);
+    return 0;
+  }
+  Vector<std::pair<uint16_t, Array<uint8_t>>> bodies;
+  for (size_t i = 0; i < shape->num_extension_bodies; i++) {
+    const RAMA_SSL_EXTENSION_BODY &entry = shape->extension_bodies[i];
+    if (entry.body == nullptr && entry.len != 0) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_PASSED_NULL_PARAMETER);
+      return 0;
+    }
+    if (entry.len > 0xffff) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_OVERFLOW);
+      return 0;
+    }
+    // BoringSSL builds the bodies of the extensions it implements, and each
+    // extension has one body.
+    bool repeated = false;
+    for (const auto &earlier : bodies) {
+      repeated |= earlier.first == entry.id;
+    }
+    if (repeated || (!rama_is_grease(entry.id) &&
+                     rama_extension_is_native(entry.id))) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_DUPLICATE_EXTENSION);
+      ERR_add_error_dataf("rama: extension body 0x%04x", (unsigned)entry.id);
+      return 0;
+    }
+    Array<uint8_t> copy;
+    if (!copy.CopyFrom(Span(entry.body, entry.len)) ||
+        !bodies.Push(std::make_pair(entry.id, std::move(copy)))) {
+      return 0;
+    }
+  }
+  // Commit: the shape replaces the previous one as a whole.
+  rama->grease_lists_set = !!shape->grease_lists_set;
+  rama->grease_lists =
+      shape->grease_lists_set ? static_cast<uint8_t>(shape->grease_lists) : 0;
+  rama->grease_values = static_cast<uint8_t>(shape->grease_values);
+  rama->grease_seed = shape->grease_seed;
+  rama->unknown_values = static_cast<uint8_t>(shape->unknown_values);
+  rama->padding = static_cast<uint8_t>(shape->padding);
+  rama->padding_length = static_cast<uint16_t>(shape->padding_length);
+  rama->extension_bodies = std::move(bodies);
+  return 1;
+}
