+// rama_raw_list validates a raw list argument.
+static bool rama_raw_list(const uint16_t *ids, size_t num) {
+  if (num > RAMA_SSL_MAX_EXTENSION_ORDER) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_OVERFLOW);
+    return false;
+  }
+  if (ids == nullptr && num != 0) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_PASSED_NULL_PARAMETER);
+    return false;
+  }
+  return rama_grease_slots_fit(Span(ids, num));
+}
+
+// rama_copy_unique copies `ids` without later duplicates. Every GREASE
+// codepoint is kept: each one marks its own slot.
+static bool rama_copy_unique(Array<uint16_t> *out, const uint16_t *ids,
+                             size_t num) {
+  Vector<uint16_t> unique;
+  for (size_t i = 0; i < num; i++) {
+    const bool repeated =
+        !rama_is_grease(ids[i]) &&
+        std::find(unique.begin(), unique.end(), ids[i]) != unique.end();
+    if (!repeated && !unique.Push(ids[i])) {
+      return false;
+    }
+  }
+  return out->CopyFrom(unique);
+}
