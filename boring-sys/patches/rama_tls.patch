+int RAMA_SSL_set_raw_supported_groups(SSL *ssl, const uint16_t *ids,
+                                      size_t num) {
+  RamaConnectionConfig *rama = rama_client_hello_config(ssl);
+  if (rama == nullptr || !rama_raw_list(ids, num)) {
+    return 0;
+  }
+  // The groups BoringSSL supports also become the ones negotiated.
+  Vector<uint16_t> known;
+  for (size_t i = 0; i < num; i++) {
+    if (!rama_is_grease(ids[i]) && ssl_group_id_to_nid(ids[i]) != NID_undef &&
+        std::find(known.begin(), known.end(), ids[i]) == known.end() &&
+        !known.Push(ids[i])) {
+      return 0;
+    }
+  }
+  if (known.empty()) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_NO_GROUPS_SPECIFIED);
+    return 0;
+  }
+  // Keep the invariants every native group setter keeps: one flag per group,
+  // and native key share selections only while they still fit the groups.
+  SSL_CONFIG *config = FromOpaque(ssl)->config.get();
+  Array<uint16_t> groups;
+  Array<uint32_t> flags;
+  Array<uint16_t> listed;
+  if (!groups.CopyFrom(known) || !flags.Init(known.size()) ||
+      !listed.CopyFrom(Span(ids, num))) {
+    return 0;
+  }
+  config->supported_group_list = std::move(groups);
+  config->supported_group_list_flags = std::move(flags);
+  clear_key_shares_if_invalid(config);
+  rama->groups = std::move(listed);
+  rama->groups_set = true;
+  return 1;
+}
