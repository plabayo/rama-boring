+// FFDHEKeyShare is an RFC 7919 group in a TLS 1.3 key_share. With q set, the
+// private exponent is uniform in [1, q-1], as for `DH_get_rfc7919_2048`.
+class FFDHEKeyShare : public SSLKeyShare {
+ public:
+  explicit FFDHEKeyShare(uint16_t group_id) : group_id_(group_id) {}
+
+  uint16_t GroupID() const override { return group_id_; }
+
+  bool Generate(CBB *out) override {
+    dh_ = rama_ffdhe_group(group_id_);
+    uint8_t *public_key;
+    // RFC 8446, section 4.2.8.1: Y is left-padded to the size of p.
+    return dh_ != nullptr && DH_generate_key(dh_.get()) &&
+           CBB_add_space(out, &public_key, DH_size(dh_.get())) &&
+           BN_bn2bin_padded(public_key, DH_size(dh_.get()),
+                            DH_get0_pub_key(dh_.get()));
+  }
+
+  bool Encap(CBB *out_ciphertext, Array<uint8_t> *out_secret,
+             uint8_t *out_alert, Span<const uint8_t> peer_key) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    return Generate(out_ciphertext) && Decap(out_secret, out_alert, peer_key);
+  }
+
+  bool Decap(Array<uint8_t> *out_secret, uint8_t *out_alert,
+             Span<const uint8_t> ciphertext) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (dh_ == nullptr) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    const size_t len = DH_size(dh_.get());
+    if (ciphertext.size() != len) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_DH_PUBLIC_VALUE_LENGTH_IS_WRONG);
+      return false;
+    }
+    UniquePtr<BIGNUM> peer(BN_bin2bn(ciphertext.data(), len, nullptr));
+    UniquePtr<BIGNUM> p_minus_1(BN_dup(DH_get0_p(dh_.get())));
+    if (peer == nullptr || p_minus_1 == nullptr ||
+        !BN_sub_word(p_minus_1.get(), 1)) {
+      return false;
+    }
+    // RFC 7919, section 5.1, requires 1 < Y < p-1. `DH_check_pub_key` needs Y
+    // reduced, and with q set it also checks Y is in the order-q subgroup.
+    int flags = 0;
+    if (BN_cmp_word(peer.get(), 1) <= 0 ||
+        BN_cmp(peer.get(), p_minus_1.get()) >= 0 ||
+        !DH_check_pub_key(dh_.get(), peer.get(), &flags) || flags != 0) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(DH, DH_R_INVALID_PUBKEY);
+      return false;
+    }
