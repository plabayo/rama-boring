+// rama_ffdhe_group returns the RFC 7919 group `group_id` with q = (p-1)/2 and
+// g = 2, or nullptr.
+UniquePtr<DH> rama_ffdhe_group(uint16_t group_id) {
+  if (group_id == SSL_GROUP_FFDHE2048) {
+    return UniquePtr<DH>(DH_get_rfc7919_2048());
+  }
+  assert(group_id == SSL_GROUP_FFDHE3072);
+  UniquePtr<BIGNUM> p(BN_bin2bn(kFFDHE3072, sizeof(kFFDHE3072), nullptr));
+  UniquePtr<BIGNUM> q(BN_new());
+  UniquePtr<BIGNUM> g(BN_new());
+  UniquePtr<DH> dh(DH_new());
+  if (!p || !q || !g || !dh ||  //
+      !BN_rshift1(q.get(), p.get()) || !BN_set_word(g.get(), 2) ||
+      !DH_set0_pqg(dh.get(), p.get(), q.get(), g.get())) {
+    return nullptr;
+  }
+  // `DH_set0_pqg` takes ownership on success.
+  p.release();
+  q.release();
+  g.release();
+  return dh;
