+    // of p.
+    Array<uint8_t> secret;
+    if (!secret.InitForOverwrite(len)) {
+      return false;
+    }
+    if (DH_compute_key_padded(secret.data(), peer.get(), dh_.get()) !=
+        static_cast<int>(len)) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      return false;
+    }
+    *out_secret = std::move(secret);
+    return true;
+  }
+
+ private:
+  uint16_t group_id_;
+  UniquePtr<DH> dh_;
+};
